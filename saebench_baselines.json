        "full": 0.951,
        "top_1": 0.657,
        "top_2": 0.723,
        "top_5": 0.780,
        "top_10": 0.830,
        "top_20": 0.878,
        "top_50": 0.921
      },
      
      "sae_best": {
        "_description": "Best SAE (BatchTopK 65k width, L0~50-150)",
        "full": 0.951,
        "top_1": 0.740,
        "top_2": 0.769,
        "top_5": 0.848,
        "top_10": null,
        "top_20": null,
        "top_50": null
      },
      
      "improvement_over_baseline": {
        "top_1": "+8.3%",
        "top_2": "+4.6%",
        "top_5": "+6.8%"
      }
    }
  },
  
  "pythia-70m-deduped": {
    "_source": "SAEBench test data",
    "layer": 4,
    "hook": "blocks.4.hook_resid_post",
