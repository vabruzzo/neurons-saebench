{
  "_source": "SAEBench results from HuggingFace: adamkarvonen/sae_bench_results_0125",
  "_paper": "SAEBench: A Comprehensive Benchmark for SAEs (arXiv:2503.09532)",
  "_note": "These are REAL baselines from the actual SAEBench evaluation suite",
  
  "gemma-2-2b": {
    "layer": 12,
    "hook": "blocks.12.hook_resid_post",
    "d_model": 2304,
    
    "sparse_probing": {
      "_datasets": ["bias_in_bios", "amazon_reviews", "github_code", "ag_news", "europarl"],
      "_note": "Averaged across 8 datasets",
      
