        "top_20": 0.911,
        "top_50": 0.932,
        "top_100": 0.941
      },
      
      "sae_best": {
        "full": 0.954,
        "top_1": 0.774,
        "top_2": 0.820,
        "top_5": 0.879,
        "top_10": 0.899,
        "top_20": 0.913,
        "top_50": 0.940,
        "top_100": 0.943
      }
    },
    
    "scr": {
      "_dataset": "bias_in_bios (professor vs nurse)",
      "sae_metric_n10": 0.757,
      "_interpretation": "Higher = better at removing spurious gender correlation"
    },
    
    "tpp": {
      "_dataset": "bias_in_bios",
      "total_metric_n10": 0.147,
      "intended_diff_n10": 0.160,
      "unintended_diff_n10": 0.013,
      "_interpretation": "Want high intended_diff, low unintended_diff"
    }
  },
  
  "key_findings_from_paper": {
    "1": "SAEs outperform LLM baseline on sparse probing by ~5-10% at k=1",
    "2": "The gap is smaller at higher k values",
    "3": "Matryoshka SAEs perform best on feature disentanglement despite worse reconstruction",
    "4": "Moderate L0 (50-150) offers best balance across metrics",
    "5": "LLM baseline on Gemma-2-2B layer 12 is ~0.65 for k=1 sparse probing"
  },
  
  "for_neurons_comparison": {
    "_goal": "Show neurons + RelP can match or exceed LLM baseline",
    "llm_baseline_k1_gemma": 0.657,
    "llm_baseline_k5_gemma": 0.780,
    "llm_baseline_k10_gemma": 0.830,
    "sae_best_k1_gemma": 0.740,
    "sae_best_k5_gemma": 0.848,
    
    "_success_criteria": [
      "If neurons k=1 > 0.657: Neurons match LLM baseline",
      "If neurons k=1 > 0.740: Neurons match SAE performance",
      "If neurons k=5 > 0.780: Strong evidence neurons work"
    ]
  }
}
